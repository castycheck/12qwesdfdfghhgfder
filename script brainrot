local function updateLockTimeEsp()
	if not Flags.LockTimeEsp then
		for plotName, instance in pairs(lockTimeEspInstances) do
			if instance and instance.Parent then instance:Destroy() end
		end
		lockTimeEspInstances = {}
		return
	end

	local myPlot = findMyPlot()
	local myPlotName = myPlot and myPlot.Name or nil

	local plots = workspace:FindFirstChild("Plots") and workspace.Plots:GetChildren() or {}
	for _, plot in pairs(plots) do
		local purchases = plot:FindFirstChild("Purchases")
		if not purchases then continue end

		local plotBlock = purchases:FindFirstChild("PlotBlock") or purchases:FindFirstChildWhichIsA("Model")
		if not plotBlock then continue end

		local main = plotBlock:FindFirstChild("Main") or plotBlock:FindFirstChildWhichIsA("BasePart")
		if not main then continue end

		local billboardGui = main:FindFirstChild("BillboardGui") or main:FindFirstChildWhichIsA("BillboardGui")
		if not billboardGui then continue end

		local timeLabel = billboardGui:FindFirstChild("RemainingTime")
		if not timeLabel then
			timeLabel = billboardGui:FindFirstChildWhichIsA("TextLabel")
		end
		if timeLabel and timeLabel:IsA("TextLabel") then
			local espName = "LockTimeESP_" .. plot.Name
			local existingBillboard = plot:FindFirstChild(espName)

			local isUnlocked = timeLabel.Text == "0s" or timeLabel.Text == "Unlocked"
