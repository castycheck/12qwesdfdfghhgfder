                    line.To = v2
                    line.Visible = true

                    local text = newDrawing("Text")
                    local distance = (camera.CFrame.Position - pos3).Magnitude
                    text.Text = string.format("%s | %.0fm", model.Name, distance)
                    text.Color = newColor3(1,1,1)
                    text.Size = 12
                    text.Center = true
                    text.Outline = true
                    text.Position = v2 + Vector2.new(0, 12)
                    text.Visible = true

                    table.insert(brainrotDrawings, { line = line, text = text, model = model })
                end
            end
        end
    end
end

