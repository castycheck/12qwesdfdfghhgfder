-- Player chams (единственная версия)
local function updatePlayerChams()
	if not Flags.PlayerChams then
		for _, highlight in pairs(playerHighlights) do
			if highlight and highlight.Parent then
				highlight:Destroy()
			end
		end
		playerHighlights = {}
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= Players.LocalPlayer and player.Character then
			local character = player.Character
			local humanoid = character:FindFirstChild("Humanoid")
			if humanoid and not playerHighlights[player] then
				local highlight = Instance.new("Highlight")
				highlight.FillColor = Color3.fromRGB(255, 0, 0)
				highlight.OutlineColor = Color3.new(0, 0, 0)
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0
				highlight.Parent = character
				playerHighlights[player] = highlight
			elseif humanoid and playerHighlights[player] then
				playerHighlights[player].Parent = character
			end
		end
	end

	for player, highlight in pairs(playerHighlights) do
		if not player or not player.Parent or not player.Character then
			if highlight then
				highlight:Destroy()
			end
			playerHighlights[player] = nil
		end
	end
end

