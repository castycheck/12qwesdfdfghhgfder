local function updateEsp(player, esp)
	local character = player and player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local rootPart = character.HumanoidRootPart
		local position, visible, depth = wtvp(rootPart.Position)
    local shouldShow = visible and Flags.PlayerEsp
    local showNick = shouldShow and (Flags.EspNick ~= false)
    local showTracer = shouldShow and (Flags.EspTracer ~= false)
    local showInfo = shouldShow and (Flags.EspInfo ~= false)
    esp.box.Visible = shouldShow
    esp.boxoutline.Visible = shouldShow
    if esp.name then esp.name.Visible = showNick end
    if esp.tracer then esp.tracer.Visible = showTracer end
    if esp.info then esp.info.Visible = showInfo end
		if rootPart and visible and shouldShow then
			local scaleFactor = 1 / (depth * tan(rad(camera.FieldOfView / 2)) * 2) * 1000
			local width, height = round(4 * scaleFactor, 5 * scaleFactor)
			local x, y = round(position.X, position.Y)
			esp.box.Size = newVector2(width, height)
			esp.box.Position = newVector2(round(x - width / 2, y - height / 2))
            esp.box.Color = espSettings.defaultcolor
			esp.boxoutline.Size = esp.box.Size
            esp.boxoutline.Position = esp.box.Position
            if esp.name and showNick then
                esp.name.Text = player.Name
                esp.name.Position = newVector2(x, round(y - height / 2) - 14)
            end
            if esp.tracer and showTracer then
                local screenH = camera.ViewportSize.Y
                esp.tracer.From = newVector2(camera.ViewportSize.X/2, screenH)
                esp.tracer.To = newVector2(x, round(y + height / 2))
            end
            if esp.info and showInfo then
                local function getPlayerSteals(p)
                    local ls = p:FindFirstChild("leaderstats")
                    local steals = ls and ls:FindFirstChild("Steals")
                    return steals and tostring(steals.Value) or "?"
                end
                local function listItemsFor(p)
                    if p == localPlayer then
                        local bp = p:FindFirstChild("Backpack")
                        if not bp then return "no backpack" end
                        local names = {}
                        for _, it in ipairs(bp:GetChildren()) do
                            if it:IsA("Tool") then table.insert(names, it.Name) end
                        end
                        if #names == 0 then return "empty" end
                        return table.concat(names, ", ")
                    else
                        local ch = p.Character
                        if not ch then return "" end
                        local names = {}
                        for _, it in ipairs(ch:GetChildren()) do
                            if it:IsA("Tool") then table.insert(names, it.Name) end
                        end
                        return #names > 0 and table.concat(names, ", ") or ""
                    end
                end
                local stealsTxt = getPlayerSteals(player)
                local itemsTxt = listItemsFor(player)
                local infoTxt = (itemsTxt ~= "" and ("Items: " .. itemsTxt .. "  ") or "") .. "Steals: " .. stealsTxt
                esp.info.Text = infoTxt
                esp.info.Position = newVector2(x, round(y + height / 2) + 14)
            end
		end
	else
		esp.box.Visible = false
        esp.boxoutline.Visible = false
        if esp.name then esp.name.Visible = false end
        if esp.tracer then esp.tracer.Visible = false end
        if esp.info then esp.info.Visible = false end
	end
end

