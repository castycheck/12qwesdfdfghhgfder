local function findMyPlot()
	if not workspace:FindFirstChild("Plots") then return nil end
	local plots = workspace.Plots:GetChildren()
	local localPlayer = Players.LocalPlayer
	local myName = localPlayer.Name .. "'s Base"
	for _, plot in pairs(plots) do
		local plotSign = plot:FindFirstChild("PlotSign")
		if plotSign then
			local surfaceGui = plotSign:FindFirstChild("SurfaceGui")
			if surfaceGui then
				local frame = surfaceGui:FindFirstChild("Frame")
				if frame then
					local textLabel = frame:FindFirstChild("TextLabel")
					if textLabel and textLabel.Text == myName then
						return plot
					end
				end
			end
		end
	end
	return nil
end

-- Anti-cheat friendly movement: split teleport into small eased steps with tiny jitter
local function safeStepTeleport(rootPart, targetCFrame, steps, stepDelay)
    steps = steps or 8
    stepDelay = stepDelay or 0.05
    local start = rootPart.CFrame
    for i = 1, steps do
        local t = i / steps
        local interp = start:Lerp(targetCFrame, t)
        -- small horizontal jitter to avoid exact-teleport signatures
        local jx = (math.random() - 0.5) * 0.2
        local jz = (math.random() - 0.5) * 0.2
        local jitter = CFrame.new(jx, 0, jz)
        pcall(function()
            if rootPart and rootPart.Parent then
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.CFrame = interp * jitter
            end
        end)
        task.wait(stepDelay)
    end
end

local function enlargeHitboxesTemporarily(deliveryHitbox, animalTarget, duration)
    if not deliveryHitbox and not animalTarget then return end
    duration = duration or 2
    local origDelivery, origAnimal
    if deliveryHitbox then origDelivery = deliveryHitbox.Size end
    if animalTarget then origAnimal = animalTarget.Size end
    pcall(function()
        if deliveryHitbox then deliveryHitbox.Size = Vector3.new(10000, 10000, 10000) end
        if animalTarget then animalTarget.Size = Vector3.new(10000, 10000, 10000) end
    end)
    task.delay(duration, function()
        pcall(function()
            if deliveryHitbox and deliveryHitbox.Parent and origDelivery then deliveryHitbox.Size = origDelivery end
            if animalTarget and animalTarget.Parent and origAnimal then animalTarget.Size = origAnimal end
        end)
    end)
end

