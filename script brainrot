					local humanoid = player.Character:FindFirstChild("Humanoid")
					if not humanoid then task.wait(1) continue end
					local originalWalkSpeed = humanoid.WalkSpeed
                    humanoid.WalkSpeed = 16
                    -- tween but with split stepping to avoid AC snaps
                    safeStepTeleport(rootPart, deliveryHitbox.CFrame * CFrame.new(0, -7, 0), 18, 0.02)
                    -- temporarily enlarge and auto-restore
                    enlargeHitboxesTemporarily(deliveryHitbox, animalTarget, 3)
					task.wait(3)
					humanoid.WalkSpeed = originalWalkSpeed
				end
				task.wait(2)
			end
		end)
	else
		local myPlot = findMyPlot()
		if myPlot then
			local deliveryHitbox = myPlot:FindFirstChild("DeliveryHitbox")
			local animalTarget = myPlot:FindFirstChild("AnimalTarget")
            if deliveryHitbox then pcall(function() deliveryHitbox.Size = Vector3.new(10, 10, 10) end) end
            if animalTarget then pcall(function() animalTarget.Size = Vector3.new(10, 10, 10) end) end
		end
	end
