-- Animals info cache
local animalInfoCache = {}
local function cacheAnimalInfo()
	local animalOverhead = ReplicatedStorage:FindFirstChild("Overheads")
	if animalOverhead then
		local animalOverheadModule = animalOverhead:FindFirstChild("AnimalOverhead")
		if animalOverheadModule then
			local ok, overheadModule = pcall(require, animalOverheadModule)
			if ok and overheadModule then
				for animalName, info in pairs(overheadModule) do
					if type(info) == "table" then
						animalInfoCache[animalName] = {
							DisplayName = info.DisplayName or animalName,
							Price = info.Price or 0,
							Rarity = info.Rarity or "Common",
							Mutation = info.Mutation or "None"
						}
					end
				end
			end
		end
	end

	local animalModels = ReplicatedStorage:FindFirstChild("Models") and ReplicatedStorage.Models:FindFirstChild("Animals")
	if animalModels then
		for _, animalModel in pairs(animalModels:GetChildren()) do
			if not animalInfoCache[animalModel.Name] then
				animalInfoCache[animalModel.Name] = {
					DisplayName = animalModel.Name,
					Price = 0,
					Rarity = "Common",
					Mutation = "None"
				}
			end
			local modelOverhead = animalModel:FindFirstChild("AnimalOverhead")
			if modelOverhead then
				local priceValue = modelOverhead:FindFirstChild("Price")
				local rarityValue = modelOverhead:FindFirstChild("Rarity")
				local displayNameValue = modelOverhead:FindFirstChild("DisplayName")
				local mutationValue = modelOverhead:FindFirstChild("Mutation")
				if priceValue then animalInfoCache[animalModel.Name].Price = priceValue.Value end
				if rarityValue then animalInfoCache[animalModel.Name].Rarity = rarityValue.Value end
				if displayNameValue then animalInfoCache[animalModel.Name].DisplayName = displayNameValue.Value end
				if mutationValue then animalInfoCache[animalModel.Name].Mutation = mutationValue.Value end
			end
		end
	end
end

local function getRarityColor(rarity)
	local rarityColors = {
		Common = Color3.fromRGB(200, 200, 200),
		Uncommon = Color3.fromRGB(0, 255, 0),
		Rare = Color3.fromRGB(0, 0, 255),
		Epic = Color3.fromRGB(128, 0, 128),
		Legendary = Color3.fromRGB(255, 215, 0),
		Mythical = Color3.fromRGB(255, 0, 255)
	}
	return rarityColors[rarity] or Color3.fromRGB(255, 255, 255)
end

local function getAnimalMutations(animalModel)
	local mutations = {}
	for _, child in pairs(animalModel:GetDescendants()) do
		if child.Name:find("_Trait.") then
			local mutationName = child.Name:gsub("_Trait.", "")
			table.insert(mutations, mutationName)
		end
	end
	return mutations
end

local function createHighlight(model, animalInfo)
	local mutations = getAnimalMutations(model)
	local mutationText = #mutations > 0 and table.concat(mutations, ", ") or "None"

	local highlight = Instance.new("Highlight")
	highlight.FillColor = getRarityColor(animalInfo.Rarity)
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.3
	highlight.OutlineTransparency = 0
	highlight.Parent = model

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 200, 0, 100)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 100
	billboard.Parent = model

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	frame.BackgroundTransparency = 0.3
	frame.BorderSizePixel = 0
	frame.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local textContainer = Instance.new("ScrollingFrame")
	textContainer.Size = UDim2.new(1, -10, 1, -10)
	textContainer.Position = UDim2.new(0, 5, 0, 5)
	textContainer.BackgroundTransparency = 1
	textContainer.BorderSizePixel = 0
	textContainer.ScrollBarThickness = 4
	textContainer.Parent = frame

	local function createTextLabel(text, color, size)
		local label = Instance.new("TextLabel")
		label.Text = text
		label.TextColor3 = color
		label.TextSize = size
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.SourceSansBold
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.TextStrokeTransparency = 0
		label.Size = UDim2.new(1, 0, 0, 20)
		label.TextXAlignment = Enum.TextXAlignment.Left
		return label
	end

	local nameLabel = createTextLabel("Name: " .. animalInfo.DisplayName, Color3.fromRGB(255, 255, 255), 14)
	nameLabel.Parent = textContainer

	local priceLabel = createTextLabel("Price: " .. tostring(animalInfo.Price), Color3.fromRGB(255, 215, 0), 12)
	priceLabel.Position = UDim2.new(0, 0, 0, 20)
	priceLabel.Parent = textContainer

	local rarityLabel = createTextLabel("Rarity: " .. animalInfo.Rarity, getRarityColor(animalInfo.Rarity), 12)
	rarityLabel.Position = UDim2.new(0, 0, 0, 40)
	rarityLabel.Parent = textContainer

	local mutationLabel = createTextLabel("Mutation: " .. mutationText, Color3.fromRGB(173, 216, 230), 12)
	mutationLabel.Position = UDim2.new(0, 0, 0, 60)
	mutationLabel.Parent = textContainer

	textContainer.CanvasSize = UDim2.new(0, 0, 0, 80)
	return highlight, billboard
