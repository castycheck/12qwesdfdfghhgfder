local function autoCollectFromPodiums()
    if autoCollecting then return end
    autoCollecting = true

    local localPlayer = Players.LocalPlayer
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        autoCollecting = false
        return
    end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then
        autoCollecting = false
        return
    end

    local rootPart = character.HumanoidRootPart
    local originalWalkSpeed = humanoid.WalkSpeed

    local function rampToSpeed(goal, step, delayStep)
        local s = humanoid.WalkSpeed
        local dir = goal > s and 1 or -1
        while math.abs(goal - s) > 0.1 do
            s = s + dir * step
            if dir == 1 then s = math.min(s, goal) else s = math.max(s, goal) end
            humanoid.WalkSpeed = s
            task.wait(delayStep)
        end
    end

    local safeWalk = math.clamp(originalWalkSpeed + 4, 16, 22)
    rampToSpeed(safeWalk, 1, 0.05)

    local myPlot = findMyPlot()
    if not myPlot then
        warn("Player's plot not found")
        rampToSpeed(originalWalkSpeed, 2, 0.05)
        autoCollecting = false
        return
    end

    local animalPodiums = myPlot:FindFirstChild("AnimalPodiums")
    if not animalPodiums then
        warn("AnimalPodiums not found in player's plot")
        rampToSpeed(originalWalkSpeed, 2, 0.05)
        autoCollecting = false
        return
    end

    local targets = {}
    for _, podium in pairs(animalPodiums:GetChildren()) do
        local claim = podium:FindFirstChild("Claim")
        local mainPart = claim and claim:FindFirstChild("Main")
        if mainPart then
            table.insert(targets, { podium = podium, pos = mainPart.Position })
        end
    end
    table.sort(targets, function(a, b)
        return (a.pos - rootPart.Position).Magnitude < (b.pos - rootPart.Position).Magnitude
    end)

    for _, t in ipairs(targets) do
        if not autoCollecting then break end
        local mainPart = t.podium.Claim and t.podium.Claim:FindFirstChild("Main")
        if not mainPart then continue end

        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        path:ComputeAsync(rootPart.Position, mainPart.Position)
        if path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()
            for _, wp in ipairs(waypoints) do
                if not autoCollecting then break end
                if wp.Action == Enum.PathWaypointAction.Jump then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
                humanoid:MoveTo(wp.Position)
                humanoid.MoveToFinished:Wait()
            end
            if autoCollecting then
                humanoid:MoveTo(mainPart.Position)
                humanoid.MoveToFinished:Wait()
                -- trigger proximity prompts/buttons if present
                local prompt = mainPart:FindFirstChildWhichIsA("ProximityPrompt") or t.podium:FindFirstChildWhichIsA("ProximityPrompt")
                if prompt then
                    pcall(function()
                        fireproximityprompt(prompt)
                    end)
                end
                task.wait(0.25)
            end
        else
            humanoid:MoveTo(mainPart.Position)
            humanoid.MoveToFinished:Wait()
            local prompt = mainPart:FindFirstChildWhichIsA("ProximityPrompt") or t.podium:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt then
                pcall(function()
                    fireproximityprompt(prompt)
                end)
            end
        end
        task.wait(0.25)
    end

    rampToSpeed(originalWalkSpeed, 2, 0.05)
    autoCollecting = false
    Window:Message({ Text = "Auto collect completed (walk-safe)!", Color = Color3.fromRGB(0, 255, 0) })
end

local function useRainbowrathSword()
	local localPlayer = Players.LocalPlayer
	local character = localPlayer.Character
	if character then
		local backpack = localPlayer:FindFirstChild("Backpack")
		local rainbowSword = backpack and backpack:FindFirstChild("Rainbowrath Sword") or nil
		if rainbowSword then
			rainbowSword.Parent = character
			if rainbowSword:IsA("Tool") then
				pcall(function() rainbowSword:Activate() end)
			end
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if rootPart then
				rootPart.Velocity = rootPart.Velocity + Vector3.new(0, 100, 0)
			end
			return true
		end
	end
	return false
end

local function startRainbowrathSwordLoop()
	if rainbowSwordLoop then rainbowSwordLoop:Disconnect() end
	rainbowSwordLoop = RunService.Heartbeat:Connect(function()
		if flyBypassEnabled then
			useRainbowrathSword()
		end
	end)
end

local function toggleFlyBypass(state)
    flyBypassEnabled = state
    local localPlayer = Players.LocalPlayer
    if state then
        startRainbowrathSwordLoop()
        if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            flyBypassEnabled = false
            return
        end
        local rootPart = localPlayer.Character.HumanoidRootPart
        local humanoid = localPlayer.Character:FindFirstChild("Humanoid")
        if not humanoid then
            flyBypassEnabled = false
            return
        end
        local originalGravity = workspace.Gravity
        local originalWalkSpeed = humanoid.WalkSpeed
        workspace.Gravity = 0
        task.spawn(function()
            while flyBypassEnabled do
                if localPlayer.Character and rootPart and rootPart.Parent then
                    local moveDirection = Vector3.new()
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection += rootPart.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection -= rootPart.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection -= rootPart.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection += rootPart.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection += Vector3.new(0, 1, 0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection += Vector3.new(0, -1, 0) end
                    rootPart.Velocity = moveDirection * 50
                end
                task.wait()
            end
            workspace.Gravity = originalGravity
            if humanoid and humanoid.Parent then
                humanoid.WalkSpeed = originalWalkSpeed
            end
        end)
    else
        workspace.Gravity = 196.2
        if rainbowSwordLoop then rainbowSwordLoop:Disconnect(); rainbowSwordLoop = nil end
    end
end

local function toggleAutoStealV1(state)
	autoStealEnabled = state
	if state then
		task.spawn(function()
			while autoStealEnabled do
				local myPlot = findMyPlot()
				if not myPlot then task.wait(1) continue end
				local deliveryHitbox = myPlot:FindFirstChild("DeliveryHitbox")
				local animalTarget = myPlot:FindFirstChild("AnimalTarget")
				if not deliveryHitbox or not animalTarget then task.wait(1) continue end
				local player = Players.LocalPlayer
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    -- anti-cheat friendly stepping instead of instant teleport
                    safeStepTeleport(player.Character.HumanoidRootPart, deliveryHitbox.CFrame * CFrame.new(0, -7, 0), 10, 0.03)
				end
                -- temporarily enlarge, then auto-restore
                enlargeHitboxesTemporarily(deliveryHitbox, animalTarget, 2)
				task.wait(2)
			end
		end)
	else
		local myPlot = findMyPlot()
		if myPlot then
			local deliveryHitbox = myPlot:FindFirstChild("DeliveryHitbox")
			local animalTarget = myPlot:FindFirstChild("AnimalTarget")
            if deliveryHitbox then pcall(function() deliveryHitbox.Size = Vector3.new(10, 10, 10) end) end
            if animalTarget then pcall(function() animalTarget.Size = Vector3.new(10, 10, 10) end) end
		end
	end
end

local function toggleAutoStealV2(state)
