local function useGrappleHook()
	local localPlayer = Players.LocalPlayer
	local character = localPlayer.Character
    if character then
        -- cooldown to avoid spamming tool
        local now = tick()
        if now - lastGrappleUse < 2.5 then return false end

        local backpack = localPlayer:FindFirstChild("Backpack")
        local grappleHook
        -- try exact name
        if backpack then grappleHook = backpack:FindFirstChild("Grapple Hook") end
        -- try fuzzy match for any tool containing 'grapple'
        if not grappleHook and backpack then
            for _, t in ipairs(backpack:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "grapple") then
                    grappleHook = t
                    break
                end
            end
        end
        -- fallback: search character or workspace
        if not grappleHook then
            for _, cont in ipairs({character, workspace}) do
                for _, t in ipairs(cont:GetChildren()) do
                    if t:IsA("Tool") and string.find(string.lower(t.Name), "grapple") then
                        grappleHook = t
                        break
                    end
                end
                if grappleHook then break end
            end
        end

        if grappleHook and grappleHook.Parent then
            -- equip tool
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid and grappleHook.Parent == backpack then
                pcall(function() humanoid:EquipTool(grappleHook) end)
                task.wait(0.1)
            elseif grappleHook.Parent ~= character then
                grappleHook.Parent = character
                task.wait(0.1)
            end

            if grappleHook.Parent and grappleHook:IsA("Tool") then
                pcall(function() grappleHook:Activate() end)
                lastGrappleUse = now
            end
            if humanoid then humanoid.WalkSpeed = 100 end
            return true
        end
    end
    return false
end

