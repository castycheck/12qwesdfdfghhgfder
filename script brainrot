-- Anti-Ragdoll
local antiRagdollEnabled = false
local antiRagdollConn, antiRagdollDescConn = nil, nil

local function stripRagdollConstraints(character)
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BallSocketConstraint") or d.Name:lower():find("ragdoll") then
            pcall(function() d.Enabled = false end)
            pcall(function() d:Destroy() end)
        end
    end
end

local function hardenHumanoid(humanoid)
    -- disable problematic states rather than forcing motion (reduces extra knockback)
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)
    if antiRagdollConn then antiRagdollConn:Disconnect() end
    antiRagdollConn = humanoid.StateChanged:Connect(function(_, _)
        if not antiRagdollEnabled then return end
        pcall(function() humanoid.PlatformStand = false end)
    end)
end

local function attachAntiRagdoll(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    stripRagdollConstraints(character)
    hardenHumanoid(humanoid)
    if antiRagdollDescConn then antiRagdollDescConn:Disconnect() end
    antiRagdollDescConn = character.DescendantAdded:Connect(function(d)
        if not antiRagdollEnabled then return end
        if d:IsA("BallSocketConstraint") or d.Name:lower():find("ragdoll") then
            task.defer(function()
                pcall(function() d.Enabled = false end)
                pcall(function() d:Destroy() end)
            end)
        end
    end)
end

local function toggleAntiRagdoll(state)
    antiRagdollEnabled = state
    local lp = Players.LocalPlayer
    if not lp.Character then return end
    if state then
        attachAntiRagdoll(lp.Character)
    else
        if antiRagdollConn then antiRagdollConn:Disconnect(); antiRagdollConn = nil end
        if antiRagdollDescConn then antiRagdollDescConn:Disconnect(); antiRagdollDescConn = nil end
        -- re-enable default states on disable
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
            end)
        end
    end
end

Players.LocalPlayer.CharacterAdded:Connect(function(char)
    if antiRagdollEnabled then
        char:WaitForChild("Humanoid", 5)
        attachAntiRagdoll(char)
    end
end)

