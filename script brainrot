-- Heartbeat loop
RunService.Heartbeat:Connect(function()
	local now = tick()

	-- Cleanup dead instances
	for i = #highlights, 1, -1 do
		local item = highlights[i]
		if not item or not item.Parent then
			if item then pcall(function() item:Destroy() end) end
			table.remove(highlights, i)
		end
	end
	for i = #highlightBillboards, 1, -1 do
		local item = highlightBillboards[i]
		if not item or not item.Parent then
			if item then pcall(function() item:Destroy() end) end
			table.remove(highlightBillboards, i)
		end
	end
	for i = #trapHighlights, 1, -1 do
		local item = trapHighlights[i]
		if not item or not item.Parent then
			if item then pcall(function() item:Destroy() end) end
			table.remove(trapHighlights, i)
		end
	end

	-- Throttled updates
	if now - lastHeartbeatUpdate > 1 then
		lastHeartbeatUpdate = now

		if Flags.HighlightAnimals then
			updateAnimalHighlights()
		else
			for i = #highlights, 1, -1 do
				local item = highlights[i]
				if item then pcall(function() if item.Parent then item:Destroy() end end) end
				highlights[i] = nil
			end
			for i = #highlightBillboards, 1, -1 do
				local item = highlightBillboards[i]
				if item then pcall(function() if item.Parent then item:Destroy() end end) end
				highlightBillboards[i] = nil
			end
		end

		if Flags.HighlightTraps then
			updateTrapHighlights()
		else
			for i = #trapHighlights, 1, -1 do
				local item = trapHighlights[i]
				if item then pcall(function() if item.Parent then item:Destroy() end end) end
				trapHighlights[i] = nil
			end
		end

		if Flags.LockTimeEsp then
			updateLockTimeEsp()
		else
			for plotName, instance in pairs(lockTimeEspInstances) do
				if instance and instance.Parent then pcall(function() instance:Destroy() end) end
				lockTimeEspInstances[plotName] = nil
			end
		end

		updateTimers()
	end

	-- Player ESP
	if Flags.PlayerEsp then
		for player, drawings in next, espCache do
			if espSettings.teamcheck and player.Team == localPlayer.Team then
				continue
			end
			if drawings and player ~= localPlayer then
				updateEsp(player, drawings)
			end
		end
	end

	-- Player Chams
	if Flags.PlayerChams then
		updatePlayerChams()
	else
		-- корректное отключение чамсов
		for player, highlight in pairs(playerHighlights) do
			if highlight and highlight.Parent then
				highlight.Enabled = false
			end
		end
	end

	-- SpeedHack
	if Flags.SpeedHack and not speedHackBypassEnabled then
		manageSpeedHack()
	end

	-- bunnyhop removed

	-- noclip loop
	if noclipEnabled then
		local lp = Players.LocalPlayer
		local char = lp.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end

	-- Anti-Ragdoll: clamp excessive knockback while enabled
	if antiRagdollEnabled then
		local lp = Players.LocalPlayer
		local char = lp.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local v = hrp.AssemblyLinearVelocity
				local max = 120 -- reduce if всё ещё улетает
				if v.Magnitude > max then
					hrpa = CFrame.new() -- no-op guard
					pcall(function() hrp.AssemblyLinearVelocity = v.Unit * max end)
				end
				local ang = hrp.AssemblyAngularVelocity
				local angMax = 12
				if ang.Magnitude > angMax then
					pcall(function() hrp.AssemblyAngularVelocity = ang.Unit * angMax end)
				end
			end
		end
	end

	-- SpeedHack Bypass - поддерживаем WalkSpeed = 100 и обновляем Brainrot ESP
	if speedHackBypassEnabled then
		local lp = Players.LocalPlayer
		if lp.Character then
			local hum = lp.Character:FindFirstChild("Humanoid")
			if hum then hum.WalkSpeed = 100 end
		end
	end

	if brainrotEspEnabled then
		updateBrainrotEsp()
	end

	-- Fog / Time
	if Flags.FogEnabled then updateFog() end
	if Flags.ChangeTime then updateTimeOfDay() end
end)

